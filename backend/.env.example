HUMANAI_ENV=dev
HUMANAI_DATABASE_URL=sqlite:///./humanai.db
HUMANAI_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
HUMANAI_RANKING_MAX_LIMIT=500
HUMANAI_CARTAS_PATH=app/data/cartas_gabarito.json
HUMANAI_DOCS_ENABLED=true

# Firebase Authentication
HUMANAI_FIREBASE_PROJECT_ID=human-ai-5c442
HUMANAI_PROFESSOR_EMAILS=
HUMANAI_FIREBASE_CHECK_REVOKED=false
HUMANAI_VINCULO_TTL_HOURS=24

# Credencial Admin: NÃO versionar e NÃO colocar neste arquivo.
# Exporte no shell/serviço uma nova chave do projeto human-ai-5c442 ou use ADC:
# export GOOGLE_APPLICATION_CREDENTIALS=/caminho/fora-do-repo/nova-chave-human-ai-5c442.json
# Alternativa: Application Default Credentials (gcloud auth application-default login)
